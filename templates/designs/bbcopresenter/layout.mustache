{{!
    @template block_kamaleon/designs/bbcopresenter/layout

    Template to render the image link design.

    Example context (json):
        {
        "contents": [
            {
                "id": 1,
                "index": 0,
                "shorttitle": "MC",
                "title": "My content",
                "subtitle": "My content subtitle",
                "url": "https://example.com",
                "target": "_blank",
                "linkname": "My content link name",
                "content": "My content description",
                "banner": "https://example.com/banner.png",
                "hasbanner": true,
                "icon": "https://example.com/icon.png",
                "hasicon": true,
                "showedition": false
            }
        ],
        "instanceid": "99",
        "attributes": []
    }
}}
<div class="container-elements" {{#attributes}}{{key}}="{{value}}"{{/attributes}} data-toslider="true">
    {{#contents}}
        <div class="card">
            <div class="card-header">
                {{#hasicon}}<img src="{{icon}}" alt="{{title}}" title="{{title}}">{{/hasicon}}
                <h3>{{title}}</h3>
                <p>{{subtitle}}</p>
            </div>
            <div class="card-body">
                {{{content}}}
            </div>
            {{#url}}
            <div class="card-footer">
                <a class="btn btn-primary" href="{{url}}" {{#target}}target="{{target}}"{{/target}} aria-label="">
                    {{#linkname}}{{linkname}}{{/linkname}}
                    {{^linkname}}{{#str}} moreinfo, block_kamaleon {{/str}}{{/linkname}}
                </a>
            </div>
            {{/url}}
            {{#showedition}}
            <div class="card-footer">
                {{> block_kamaleon/edition}}
            </div>
            {{/showedition}}
        </div>
    {{/contents}}
</div>
