{{!
    @template block_kamaleon/comfezigzag/layout

    The designed layout.

    Example context (json):
    {
        "attributes": {
            "contents": {
                "id": 1,
                "index": 0,
                "shorttitle": "MC",
                "title": "My content",
                "subtitle": "My content subtitle",
                "url": "https://example.com",
                "target": "_blank",
                "linkname": "My content link name",
                "content": "My content description",
                "banner": "https://example.com/banner.png",
                "hasbanner": true,
                "icon": "https://example.com/icon.png",
                "hasicon": true,
                "showedition": false
            },
            "instanceid": "99"
        }
    }
}}

<section class="container-cards" {{#attributes}}{{key}}="{{value}}"{{/attributes}}>
    {{#contents}}
    <div class="card-cards">
        {{#url}}
            <a href="{{url}}" {{#target}}target="{{target}}"{{/target}} class="card-box{{#inmodal}} kam-openinmodal{{/inmodal}}">
        {{/url}}
        {{^url}}
            <div class="card-box">
        {{/url}}
            <div class="card_icon">
                {{#icon}}
                    <img src="{{icon}}" alt="{{subtitle}}" title="{{subtitle}}">
                {{/icon}}
            </div>
            <div class="card_body">
                <div class="card_tag">
                    {{shorttitle}}
                </div>
                <h5>
                    {{title}}
                </h5>
                <div class="card_content">
                    {{{content}}}
                </div>
            </div>
            <div class="card_imagen">
                {{#banner}}
                    <img src="{{banner}}" alt="{{title}}" title="{{title}}">
                {{/banner}}
            </div>
        {{#url}}
            </a>
        {{/url}}
        {{^url}}
            </div>
        {{/url}}
        {{#showedition}}
            {{> block_kamaleon/edition}}
        {{/showedition}}
    </div>
    {{/contents}}
</section>
