{{!
    @template block_kamaleon/indicatoronscale/layout

    The designed layout.

    Example context (json):
        {
        "contents": [
            {
                "id": 1,
                "index": 0,
                "shorttitle": "MC",
                "title": "My content",
                "subtitle": "My content subtitle",
                "url": "https://example.com",
                "target": "_blank",
                "linkname": "My content link name",
                "content": "My content description",
                "banner": "https://example.com/banner.png",
                "hasbanner": true,
                "icon": "https://example.com/icon.png",
                "hasicon": true,
                "showedition": false
            }
        ],
        "instanceid": "99",
        "contentstotal": 5,
        "attributes": []
    }
}}

<div class="container-indicators">
    {{#contents}}
    <div class="indicator-box" style="--index: {{index}}; --total: {{contentstotal}};">
        <div class="indicator_icon">
            {{#icon}}<img src="{{icon}}" alt="{{title}}" title="{{title}}" />{{/icon}}
            {{#shorttitle}}<h6>{{shorttitle}}</h6>{{/shorttitle}}
        </div>
        <div class="indicator_body">
            {{#title}}<h4>{{title}}</h4>{{/title}}
            {{#subtitle}}<h5>{{subtitle}}</h5>{{/subtitle}}
            {{#showedition}}
                {{> block_kamaleon/edition}}
            {{/showedition}}
        </div>
    </div>
    {{/contents}}
</div>
