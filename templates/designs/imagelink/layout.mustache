{{!
    @template block_kamaleon/designs/imagelink/layout

    Template to render the image link design.

    Example context (json):
    {
        "attributes": {
            "contents": {
                "id": 1,
                "index": 0,
                "shorttitle": "MC",
                "title": "My content",
                "subtitle": "My content subtitle",
                "url": "https://example.com",
                "target": "_blank",
                "linkname": "My content link name",
                "content": "My content description",
                "banner": "https://example.com/banner.png",
                "hasbanner": true,
                "icon": "https://example.com/icon.png",
                "hasicon": true,
                "showedition": false
            },
            "instanceid": "99"
        }
    }
}}
<div class="container-elements" data-toslider="true">
    {{#contents}}
    <div>
        <a href="{{url}}" {{#target}}target="{{target}}"{{/target}} aria-label="{{title}}">
            {{#hasbanner}}<img src="{{banner}}" alt="{{title}}" title="{{title}}" />{{/hasbanner}}
            {{#linkname}}{{linkname}}{{/linkname}}
        </a>
        {{#showedition}}
            {{> block_kamaleon/edition}}
        {{/showedition}}
    </div>
    {{/contents}}
</div>
